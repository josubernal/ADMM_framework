#!/bin/bash

#SBATCH --job-name quick_test
#SBATCH --output test_output_%j.txt
#SBATCH --error test_error_%j.txt
#SBATCH --mail-user bernaljosu@dei.unipd.it
#SBATCH --mail-type END,FAIL

# Kept your cluster-specific routing
#SBATCH --exclude runner-[07-19],gpu[1-7]
#SBATCH --partition allgroups

# Minimal resource requests
#SBATCH --ntasks 1
#SBATCH --mem 100M          # Reduced from 16G to 100 Megabytes
#SBATCH --time 00:01:00    # Reduced from 1 hour to 1 minute

cd $SLURM_SUBMIT_DIR

# Simple, lightweight commands to verify execution
echo "Test job started successfully!"
echo "Running on compute node: $(hostname)"
echo "Current directory is: $(pwd)"

# A tiny sleep just so you have a few seconds to see it in 'squeue' if you check quickly
sleep 10 

echo "Test job finished!"